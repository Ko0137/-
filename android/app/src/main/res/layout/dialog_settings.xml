<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:text="⚙️ Настройки Разрешений L.I.R.A."
        android:textColor="@color/primary_emerald"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Switch 1: Microphone -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@color/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎙️ Запись голоса (Микрофон)"
            android:textColor="@color/text_white"
            android:textSize="14sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_mic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:useMaterialThemeColors="true" />
    </LinearLayout>

    <!-- Switch 2: Physical Activity -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@color/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="👟 Сенсор шагов (Шагомер)"
            android:textColor="@color/text_white"
            android:textSize="14sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_pedometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:useMaterialThemeColors="true" />
    </LinearLayout>

    <!-- Switch 3: Camera / Flashlight -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@color/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔦 Фонарик / Вспышка"
            android:textColor="@color/text_white"
            android:textSize="14sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_camera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:useMaterialThemeColors="true" />
    </LinearLayout>

    <!-- Switch 4: Floating Widget Overlay -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@color/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎈 Поверх других окон (Виджет)"
            android:textColor="@color/text_white"
            android:textSize="14sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:useMaterialThemeColors="true" />
    </LinearLayout>

    <!-- Section 5: App Icon Theme Selector -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="🎨 Иконка Приложения (Дизайн)"
        android:textColor="@color/primary_emerald"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rg_icon_theme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@color/bg_card"
        android:orientation="vertical"
        android:padding="8dp">

        <RadioButton
            android:id="@+id/rb_icon_emerald"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🟢 Иконка Emerald (Изумрудная)"
            android:textColor="@color/text_white" />

        <RadioButton
            android:id="@+id/rb_icon_violet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🟣 Иконка Neon Violet (Неон)"
            android:textColor="@color/text_white" />

        <RadioButton
            android:id="@+id/rb_icon_gold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🟡 Иконка Cyber Gold (Золотая)"
            android:textColor="@color/text_white" />

        <RadioButton
            android:id="@+id/rb_icon_blue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔵 Иконка Crystal Blue (Лазурная)"
            android:textColor="@color/text_white" />
    </RadioGroup>

    <Button
        android:id="@+id/btn_close_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/primary_emerald"
        android:text="Готово"
        android:textColor="@color/bg_dark"
        android:textStyle="bold" />

</LinearLayout>
